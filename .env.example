# Backend LLM (lm_studio | ollama)
LLM_BACKEND=lm_studio

# LM Studio
LM_STUDIO_API_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=
LM_STUDIO_MODEL=qwen3.5-9b-claude-4.6-opus-reasoning-distilled-v2
LM_STUDIO_REASONING_MODEL=qwen3.5-9b-claude-4.6-opus-reasoning-distilled-v2
LM_STUDIO_SYSTEM_PROMPT=Sei un assistente preciso e coerente. Segui le istruzioni alla lettera.
LM_STUDIO_FALLBACK_MODELS=qwen3.5-9b-claude-4.6-opus-reasoning-distilled-v2,qwen2.5-7b-instruct-1m,deepseek-coder-v2-lite-instruct
